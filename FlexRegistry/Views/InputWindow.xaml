<Window x:Class="FlexRegistry.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexRegistry.Views"
        mc:Ignorable="d"
        Height="130" Width="240" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBox x:Name="InputBox" Margin="12" KeyUp="InputBox_KeyUp"></TextBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12" HorizontalAlignment="Center">
            <Button Click="OkButton_Click" Content="ОК" Width="60"/>
            <Button Click="CancelButton_Click" Content="Отмена" Width="60" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
