    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Базовые поля" VerticalAlignment="Stretch">
            <ListView x:Name="BasicFieldsListView" KeyboardNavigation.TabNavigation="Continue" Margin="0,4,0,0" SelectionMode="Single" SelectedItem="{Binding SelectedItem}" ItemsSource="{Binding BasicFields}" VerticalAlignment="Stretch"
                PreviewMouseLeftButtonDown="BasicFieldsListView_PreviewMouseLeftButtonDown"
                PreviewMouseMove="BasicFieldsListView_PreviewMouseMove"
                Drop="BasicFieldsListView_Drop"
                AllowDrop="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="DragAnchor" Content="{StaticResource GrabIcon}" VerticalAlignment="Center" Padding="1,2,0,1"/>
                            <TextBox x:Name="FieldBox" Text="{Binding Name}" FontSize="18" Margin="18,0,0,0" GotFocus="FieldBox_GotFocus"/>
                            <StackPanel Grid.Column="1">
                                <CheckBox IsChecked="{Binding IsRequired}" Content="Обязательное"/>
                                <CheckBox IsChecked="{Binding IsVisible}" Content="Отображаемое"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Name="AddMenuItem" Click="AddMenuItem_Click" Header="Добавить"/>
                        <MenuItem Name="RemoveMenuItem" Click="RemoveMenuItem_Click" Header="Удалить"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </GroupBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Command="{Binding SaveButtonClick}" Content="Сохранить" Width="80" Padding="0,0,0,1"/>
            <Button Command="{Binding CancelButtonClick}" Content="Отмена" Width="80" Margin="10,0,0,0" Padding="0,0,0,1"/>
        </StackPanel>
    </Grid>
</Window>
