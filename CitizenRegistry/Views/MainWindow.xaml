<Window x:Class="CitizenRegistry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CitizenRegistry.ViewModels"
        xmlns:local="clr-namespace:CitizenRegistry"
        mc:Ignorable="d"
        Title="{Binding DatabaseName}" Height="800" Width="1100" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel x:Name="MainVM"/>
    </Window.DataContext>
    <Window.Resources>
        <Path x:Key="EditIcon" x:Shared="False"
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" 
        Stroke="Black"
        Stretch="Fill"
        Data="M12 4H6C4.89543 4 4 4.89543 4 6V18C4 19.1046 4.89543 20 6 20H18C19.1046 20 20 19.1046 20 18V12M9 15V12.5L17.75 3.75C18.4404 3.05964 19.5596 3.05964 20.25 3.75V3.75C20.9404 4.44036 20.9404 5.55964 20.25 6.25L15.5 11L11.5 15H9Z"/>
        <Path x:Key="RemoveIcon" x:Shared="False"
        HorizontalAlignment="Center" 
        VerticalAlignment="Center" 
        Stroke="Black"
        Stretch="Fill"
        Data="M6 7V18C6 19.1046 6.89543 20 8 20H16C17.1046 20 18 19.1046 18 18V7M6 7H5M6 7H8M18 7H19M18 7H16M10 11V16M14 11V16M8 7V5C8 3.89543 8.89543 3 10 3H14C15.1046 3 16 3.89543 16 5V7M8 7H16"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Кнопки экспорт/настройки -->
            <RowDefinition Height="Auto"/>
            <!-- Поиск -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки добавить/удалить -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <!-- Основной контент -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Автоширина по контенту -->
            <ColumnDefinition Width="*"/>
            <!-- Оставшееся пространство -->
        </Grid.ColumnDefinitions>

        <!-- Строка 1: Кнопки экспорт и настройки -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
            <!--<Button Command="{Binding HelpButtonClick}" Content="Помощь" Padding="10,5" Margin="5" MinWidth="80"/>-->
            <Button Command="{Binding SettingsButtonClick}" Content="Настройки" Padding="10,5" Margin="5" MinWidth="80"/>
            <Button Command="{Binding ImportMassPersons}" Padding="10,5" Margin="5" MinWidth="80">
                Массовая загрузка
            </Button>
        </StackPanel>
        <!--Кнопка выхода
        Не нужна, т.к. есть событие на закрытие в Window
        <Button Command="{Binding ExitButtonClick}" Background="#FF6D6A" Content="Выход" Margin="10" Padding="0,0,0,2" Width="60" Grid.Column="1" HorizontalAlignment="Right"/>
        -->

        <!-- Строка 2: Поиск -->
        <GroupBox Header="Поиск" FontSize="10" Padding="0,5,0,0" Grid.Row="1" Grid.ColumnSpan="2" Margin="10">
            <TextBox x:Name="SearchBox" FontSize="12"  Padding="5" TextChanged="SearchBox_TextChanged" KeyUp="SearchBox_KeyUp"/>
        </GroupBox>


        <!-- Строка 3: Кнопки добавить/удалить -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
            <Button Command="{Binding AddPerson}" Content="Добавить" Margin="5,5" Padding="10,5"/>
            <Button Command="{Binding RemoveButtonClick}" Content="Удалить" Margin="5,5" Padding="10,5"/>
        </StackPanel>
        <!-- Строка 4: Основной контент -->
        <!-- Левая колонка - Список граждан -->
        <Border Grid.Row="3" Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,1,1,0" Margin="8,0,0,8">
            <ListView MinWidth="200" ItemsSource="{Binding FilteredPersons}" SelectionMode="Single" SelectedItem="{Binding SelectedItem}" x:Name="PersonList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                <!-- Шаблон элемента с кнопками -->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding VisibleValue}" VerticalAlignment="Center" Padding="5" 
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="2" HorizontalAlignment="Right">
                                <Button Content="{StaticResource EditIcon}" Click="EditPersonButton_Click" CommandParameter="{Binding .}" ToolTip="Редактировать" ToolTipService.InitialShowDelay="7"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <EventSetter Event="MouseDoubleClick" Handler="PersonList_MouseDoubleClick"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>

        <!-- Правая колонка - Документы и записи -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" BorderBrush="Black" Background="#E0E0E0" BorderThickness="1" Margin="2,0,8,8">
            <Grid Visibility="{Binding IsOverviewAvailable}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Документы -->
                    <RowDefinition Height="*"/>
                    <!-- Записи -->
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
                    <Button Command="{Binding AddRecord}" Background="White" Content="Добавить запись" Margin="5,5" Padding="10,5"/>
                    <Button Command="{Binding AddFile}" Background="White" Content="Добавить файлы" Margin="5,5" Padding="10,5"/>
                </StackPanel>
                <Button Command="{Binding CloseOverview}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#960923" Content="✕" Foreground="White" Margin="2" ToolTip="Закрыть"/>
                <!-- Блок документов -->
                <GroupBox Visibility="{Binding IsFilesVisible}" Header="Файлы" Grid.Row="1" Margin="5">
                    <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled">
                        <ListView x:Name="FilesListBox" 
                            ItemsSource="{Binding Files}" 
                            SelectionMode="Extended"
                            Background="Transparent"
                            BorderThickness="0">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <!--<Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>-->
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <!--<EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"/>-->
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Name="ExportFiles" Click="ExportFiles_Click" Header="Экспорт"/>
                                    <MenuItem Name="RemoveFiles" Click="RemoveFiles_Click" Header="Удалить"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border 
                                        Margin="5"
                                        Padding="10"
                                        Background="White"
                                        ToolTip="{Binding OriginalName}"
                                        ToolTipService.InitialShowDelay="5"
                                        Cursor="Hand">

                                        <!-- Обработка событий -->
                                        <Border.InputBindings>
                                            <MouseBinding 
                                                MouseAction="LeftDoubleClick"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding DataContext.OpenLoadedFile, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"/>
                                        </Border.InputBindings>

                                        <!-- Содержимое -->
                                        <StackPanel IsHitTestVisible="False">
                                            <Path 
                                                HorizontalAlignment="Center" 
                                                VerticalAlignment="Center" 
                                                Fill="#90CAF9" 
                                                Data="M40 45L8 45 8 3 30 3 40 13z"
                                                Stretch="Fill"
                                                Stroke="Black"/>
                                            <TextBlock 
                                                Text="{Binding ShortName}" 
                                                TextAlignment="Center"
                                                MinWidth="80"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </GroupBox>

                <!-- Блок записей -->
                <GroupBox Visibility="{Binding IsRecordsVisible}" Header="Записи" Grid.Row="2" Margin="5">
                    <ListView Height="Auto" ItemsSource="{Binding Records}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="False">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="5" Margin="2" BorderThickness="1" BorderBrush="Black">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBox IsReadOnly="True" FontSize="15" Grid.Row="0" Grid.Column="0" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DisplayDate, StringFormat=d, ConverterCulture=ru-RU}" 
                                                    FontStyle="Italic" Foreground="Gray"/>

                                        <StackPanel HorizontalAlignment="Left" Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" 
                                                    Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{StaticResource EditIcon}" Padding="5,2" Margin="2" ToolTip="Редактировать" Click="EditRecordButton_Click" CommandParameter="{Binding .}"/>
                                            <Button Content="{StaticResource RemoveIcon}" Padding="5,2" Margin="2" ToolTip="Удалить" Click="RemoveRecordButton_Click" CommandParameter="{Binding .}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </GroupBox>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
            <TextBlock Text="" Margin="8,0,0,0" Padding="0,2,0,0" HorizontalAlignment="Stretch"/>
            <Button Command="{Binding LogPanelClick}" Content="^" FontSize="14" Width="20" Margin="0,0,8,0" HorizontalAlignment="Right"/>
        </Grid>
        <Border x:Name="LogPanel"
                  VerticalAlignment="Bottom"
                  Height="400"
                  Panel.ZIndex="1"
                  Background="#FFF0F0F0"
                  RenderTransformOrigin="0.5,1"
                  Visibility="{Binding LogPanelVisibility}"
                  Grid.ColumnSpan="2"
                  Margin="8,8,8,4" Grid.Row="1" Grid.RowSpan="3"
                  BorderThickness="2"
                  BorderBrush="Black">
            <Grid>


                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок панели -->
                <Border Grid.Row="0" Background="#FFE0E0E0" Padding="5">
                    <TextBlock Text="Журнал событий" FontWeight="Bold"/>
                </Border>

                <!-- Область с логами -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
                    <TextBlock x:Name="LogTextBlock" 
                               TextWrapping="Wrap" 
                               Padding="10"
                               Text="[В разработке]"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>