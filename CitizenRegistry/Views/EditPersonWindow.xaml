    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Основные данные">
            <ListView x:Name="BasicDataListView" KeyboardNavigation.TabNavigation="Continue" FontSize="15" ItemsSource="{Binding BasicFields}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="4,0,0,0" Text="{Binding DisplayFormat}"/>
                            <TextBox Margin="5, 0, 0, 2" Grid.Column="1" Text="{Binding Value}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Focusable" Value="False"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Доп. данные">
            <ListView x:Name="AdditionalDataListView" KeyboardNavigation.TabNavigation="Continue" SelectionMode="Single" FontSize="15" SelectedItem="{Binding AdditionalSelectedItem}" ItemsSource="{Binding AdditionalFields}"
                PreviewMouseLeftButtonDown="AdditionalDataListView_PreviewMouseLeftButtonDown"
                PreviewMouseMove="AdditionalDataListView_PreviewMouseMove"
                Drop="AdditionalDataListView_Drop"
                AllowDrop="True" ItemContainerStyle="{DynamicResource ListViewItemContainerStyle}">
                <ListView.Resources>
                    <Style x:Key="ListViewItemContainerStyle" TargetType="{x:Type ListViewItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label x:Name="DragAnchor" Content="{StaticResource GrabIcon}" VerticalAlignment="Center" Height="20" Padding="1,1,0,1"/>
                            <TextBox Margin="15,0,0,0" MinWidth="80" Text="{Binding Key}"/>
                            <TextBox Margin="5,0,0,0" Grid.Column="1" Text="{Binding Value}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Name="AddMenuItem" Click="AddMenuItem_Click" Header="Добавить"/>
                        <MenuItem Name="RemoveMenuItem" Click="RemoveMenuItem_Click" Header="Удалить"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </GroupBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
            <Button Command="{Binding SaveButtonClick}" Content="Сохранить" Width="80" Padding="0,0,0,1"/>
            <Button Command="{Binding CancelButtonClick}" Content="Отмена" Width="80" Margin="10,0,0,0" Padding="0,0,0,1"/>
        </StackPanel>
    </Grid>
</Window>
